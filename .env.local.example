# ============================================================================
# RigScout environment variables
# ----------------------------------------------------------------------------
# Copy this file to ".env.local" for local testing, and add the SAME values in
# Vercel later (Project → Settings → Environment Variables).
#
# The app runs WITHOUT these using built-in sample data, so you can try it
# before signing up. Add the key to switch on LIVE Amazon prices + photos.
# ============================================================================

# Your RapidAPI key for the "Real-Time Amazon Data" API.
# Get it: rapidapi.com → sign up (free) → subscribe to "Real-Time Amazon Data"
# (free tier, no card) → copy the "X-RapidAPI-Key" value here.
RAPIDAPI_KEY=

# Your Amazon Associates tag (e.g. rigscout-20). Appended to every buy link so
# you earn commission. Leave blank until your Associates account is approved.
AMAZON_ASSOCIATE_TAG=

# How many pages of Amazon results to pull per search. Leave it out entirely and
# it uses 2, which is the right answer for almost everyone.
#   1 = shallower catalog, roughly half the API calls
#   2 = the default: ~1,300 graphics cards, ~5,600 parts overall
#   3 = maximum depth, for the paid RapidAPI plan only
# See the "How many results you actually get" section of README.md before
# raising this — every search is an API request, and the free tier is 100 a month.
CATALOG_PAGES=2

# ----------------------------------------------------------------------------
# Community + partner links
# ----------------------------------------------------------------------------
# These are PUBLIC by design — they end up in the HTML, which is the whole
# point of a referral link. Never put a secret behind a NEXT_PUBLIC_ name.

# The Discord invite shown in the nav, footer, home page and builder. Already
# has a working permanent invite baked in as the fallback, so this is only
# needed if you regenerate the link.
NEXT_PUBLIC_DISCORD_INVITE=

# Affiliate URLs for the three services on /extras ("Beyond the Build").
# Leave any of them blank and the site links to the plain public page instead —
# the link still works, it just doesn't pay anything. Sign up for each program
# first, then paste the tracking URL they give you here (and in Vercel).
#   Backblaze  — Computer Backup, recurring commission
#   BisectHosting — game/Minecraft server hosting, recurring commission
#   NordVPN    — one-off commission per sign-up
NEXT_PUBLIC_BACKBLAZE_URL=
NEXT_PUBLIC_BISECT_URL=
NEXT_PUBLIC_VPN_URL=
