# ============================================================================
# RigScout environment variables
# ----------------------------------------------------------------------------
# Copy this file to ".env.local" for local work. In production, set the same
# names in Vercel (Project -> Settings -> Environment Variables).
#
# READ THIS FIRST, because it is not what you would expect:
#
#   The website does not need an API key.
#
# Every product and price on the site comes from data/catalog.json, a file that
# ships with the code. Nothing on the live site calls Amazon, so there is no key
# to set, no quota to run out, and no per-visitor cost. The key below is only
# used when REBUILDING that file, which happens on GitHub's machines twice a
# month -- see .github/workflows/catalog.yml.
# ============================================================================


# ----------------------------------------------------------------------------
# THE ONE YOU ACTUALLY NEED IN VERCEL
# ----------------------------------------------------------------------------

# Your Amazon Associates tag (e.g. rigscout-20). Appended to every buy link so
# you earn commission. Leave blank until your Associates account is approved --
# links still work, they just don't pay.
#
# It is applied when a page renders, not when the catalog is built, so setting
# this later starts earning immediately. You do not have to rebuild anything.
AMAZON_ASSOCIATE_TAG=


# ----------------------------------------------------------------------------
# FOR REBUILDING THE CATALOG
# ----------------------------------------------------------------------------

# Your RapidAPI key for "Real-Time Amazon Data".
# Get it: rapidapi.com -> sign up (free, no card) -> subscribe to "Real-Time
# Amazon Data" on the free plan -> copy the "X-RapidAPI-Key" value.
#
# WHERE THIS BELONGS:
#   - GitHub -> Settings -> Secrets and variables -> Actions, named RAPIDAPI_KEY
#     (this is the normal way; the scheduled rebuild reads it from there)
#   - or here in .env.local, if you want to run `npm run catalog` yourself
#
# WHERE IT MUST NEVER GO:
#   - anywhere in the repository
#   - any variable name starting with NEXT_PUBLIC_
#   Either one would publish it to every visitor.
#
# It is not needed in Vercel at all, unless you switch on LIVE_SEARCH below.
RAPIDAPI_KEY=


# ----------------------------------------------------------------------------
# OPTIONAL: LIVE SEARCH
# ----------------------------------------------------------------------------

# By default the search box searches the stored catalog -- a few hundred parts,
# free, instant, and it cannot break. Set this to 1 (AND set RAPIDAPI_KEY in
# Vercel) and the search box queries Amazon directly instead, so people can find
# parts the catalog doesn't carry. Browse pages stay free either way.
#
# Both variables are required on purpose. On the 100-request free plan a single
# curious visitor with a search box can spend a month's quota in a minute, and
# discovering that from a billing page is worse than never having switched it
# on. Leave this off unless you are on a paid plan.
#
# LIVE_SEARCH=1


# ----------------------------------------------------------------------------
# COMMUNITY + PARTNER LINKS
# ----------------------------------------------------------------------------
# These are PUBLIC by design -- they end up in the HTML, which is the whole
# point of a referral link. Never put a secret behind a NEXT_PUBLIC_ name.

# The Discord invite shown in the nav, footer, home page and builder. A working
# permanent invite is already baked in as the fallback, so this is only needed
# if you regenerate the link.
NEXT_PUBLIC_DISCORD_INVITE=

# Affiliate URLs for the three services on /extras ("Beyond the Build").
# Leave any of them blank and the site links to the plain public page instead --
# the link still works, it just doesn't pay anything. Sign up for each program
# first, then paste the tracking URL they give you here (and in Vercel).
#   Backblaze     -- Computer Backup, recurring commission
#   BisectHosting -- game/Minecraft server hosting, recurring commission
#   NordVPN       -- one-off commission per sign-up
NEXT_PUBLIC_BACKBLAZE_URL=
NEXT_PUBLIC_BISECT_URL=
NEXT_PUBLIC_VPN_URL=
